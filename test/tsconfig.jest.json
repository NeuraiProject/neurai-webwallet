{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "__tests__/**/*.ts"
  ]
}
