{
  "name": "neurai-wallet",
  "version": "1.0.11",
  "description": "Web wallet for Neurai",
  "private": true,
  "scripts": {
    "test": "jest -c test/jest.config.js",
    "test:watch": "jest -c test/jest.config.js --watch",
    "test:coverage": "jest -c test/jest.config.js --coverage",
    "build": "parcel build public/index.html --no-source-maps",
    "prebuild": "node update-build-date.js",
    "watch": "parcel watch public/index.html",
    "start": "parcel public/index.html",
    "prestart": "node update-build-date.js",
    "dev": "parcel public/index.html --https",
    "postinstall": "node generateCommitHash.js"
  },
  "keywords": [
    "Neurai",
    "XNA"
  ],
  "author": "Neurai Community",
  "license": "MIT",
  "dependencies": {
    "@neuraiproject/neurai-depin-msg": "^2.1.3",
    "@neuraiproject/neurai-history-list": "^1.2.5",
    "@neuraiproject/neurai-jswallet": "0.14.0",
    "@neuraiproject/neurai-message": "^0.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@yudiel/react-qr-scanner": "^2.5.1",
    "bip39": "^3.1.0",
    "dompurify": "^3.1.6",
    "marked": "^12.0.2",
    "parcel": "^2.16.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "assert": "^2.1.0",
    "autoprefixer": "^10.5.0",
    "buffer": "^5.5.0||^6.0.0",
    "daisyui": "^5.5.19",
    "events": "^3.3.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.10",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.4.9",
    "vm-browserify": "^1.1.2"
  }
}
